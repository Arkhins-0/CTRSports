# ─── Hostnames ────────────────────────────────────────────────────────────
# No domain is written down anywhere in the source. These two values are the
# only place this deployment learns its own name.

# The public origin — no trailing slash. Every canonical URL, the sitemap, the
# Open Graph tags and the JSON-LD are built from it.
# Read at BUILD time for statically rendered metadata: set it before next build.
SITE_URL=https://example.com

# Hosts that serve the ADMIN instead of the public site, comma-separated.
# One deployment answers on both; src/middleware.ts routes on the Host header.
# Unset means NO host is the admin host — the admin is then unreachable and the
# public site is unaffected, which is the safe way round to fail.
# Must be set at BUILD time as well as run time: middleware runs in the Edge
# runtime, where process.env is inlined when the app is compiled.
# In development, ports 4000 and 127.0.0.1:4000 are added automatically.
ADMIN_HOSTS=admin.example.com

# Set to 1 ONLY behind a proxy you control that overwrites x-forwarded-host.
# The header is client-supplied, so trusting it elsewhere lets anyone ask the
# public domain for admin routing. Vercel, Render, Fly and Railway need nothing.
# TRUST_FORWARDED_HOST=1

# ─── Services ─────────────────────────────────────────────────────────────

# Neon Postgres — sports cards, admin accounts, admin sessions.
# This project's tables are all prefixed `ctr_`, so it could share a database
# with another CTR site without colliding with its tables.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Object storage — everything uploaded from the admin dashboard.
# Any S3-compatible bucket. Leave unset to run the admin with pasted URLs only.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set ONLY when the bucket is not on AWS — Neon's object storage, for instance.
# The client then talks to this address in path-style (https://host/bucket/key),
# which is the form such endpoints answer. Unset means plain AWS S3.
# Neon: https://<project>.storage.<region>.aws.neon.tech
S3_ENDPOINT=

# Where uploaded media is SERVED from — the CloudFront distribution in front of
# the bucket, no trailing slash. Two things read it: the upload route, which
# writes this host into the database with every new image, and src/config/media.ts,
# which the default images and the preconnect are built from.
# Unset means both fall back to the bucket's own address — <S3_ENDPOINT>/<bucket>
# when an endpoint is set, https://<bucket>.s3.<region>.amazonaws.com otherwise —
# which only works while the bucket is publicly readable. On Neon there is no
# CDN in front of the bucket, so this is simply <S3_ENDPOINT>/<bucket>.
# NEXT_PUBLIC_, so it is inlined at BUILD time: on Vercel, changing it needs a
# redeploy, not a restart. Rows written before it was set keep the old hostname —
# `npm run migrate:media` is what moves those.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Predates the variable above and still wins if set, for a deployment that had it
# first. Same meaning; there is no reason to set both.
# S3_PUBLIC_BASE_URL=https://media.example.com

# Signs each rendered registration form, so the submit route can tell somebody
# filling one in from a script that fetched the page and posted it straight
# back. Any long random string — `openssl rand -base64 32` will do.
# Unset means that one check is skipped: entries are still validated, rate
# limited and honeypotted, and the server says once in its log that the timing
# check is off. Changing it invalidates forms that are open in a browser right
# now, who are asked to reload.
REGISTER_SECRET=
