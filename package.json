{
  "name": "ctr-sports",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "webp": "node scripts/convert-webp.mjs",
    "db:migrate": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:status": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate.mjs --status",
    "db:reconcile": "node --env-file=.env --env-file-if-exists=.env.local scripts/reconcile-checksums.mjs",
    "db:seed": "node --env-file=.env --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:types": "node --env-file=.env --env-file-if-exists=.env.local scripts/gen-types.mjs",
    "migrate:media": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate-media-domain.mjs",
    "migrate:media:sites": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate-media-sites.mjs",
    "migrate:storage": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate-storage.mjs",
    "create-admin": "node --env-file=.env --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "check:forms": "tsx scripts/check-forms.ts",
    "check:decks": "tsx scripts/check-decks.ts",
    "check:articles": "tsx scripts/check-articles.ts",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "next": "^15.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "vercel": "^58.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
